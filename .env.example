# Copy this file to ".env" and fill in your real values. ".env" is gitignored — never commit it.
# Get these from: Shopify admin → Settings → Apps and sales channels → Develop apps →
#   (your app) → API credentials → "Admin API access token" (Reveal once).

# Your store's permanent backend domain, e.g. noseymutt-1234.myshopify.com (NOT noseymutt.com)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# The Admin API access token — starts with "shpat_"
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API version. Leave as-is unless told otherwise; the ping script will flag if it's invalid.
SHOPIFY_API_VERSION=2026-04
